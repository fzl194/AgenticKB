# .dockerignore
.git
__pycache__
*.pyc
.pytest_cache
.mypy_cache
node_modules
*.log
*.tar.gz
# 离线镜像是构建产物，不能再次进入 Docker 构建上下文
cmkb*.tar
cmkb*.tar.zst
*.zst
*.sha256
# 增量同步包（deploy-sync.sh pack 产物）与宿主机运行时产物目录同理
sync-*.tar.gz
kb-ui-dist/
runtime/
.cmkb-sync-stage.*
.cmkb-pack-stage.*
.cmkb-code-stage.*
.cmkb-code-backup.*
logs/

# 不需要打包的目录
agent_serving/
agent_serving_fzl/
agent_serving_zdy/
knowledge_mining_fzl/
knowledge_mining_zym/
MML/
old/
docs/
scripts/
data/
.claude/
tests/
