<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.AssetDocumentMapper">

    <resultMap id="docFileResult"
               type="com.coremasterkb.serving.mapper.result.DocumentFileRow">
        <result column="id"            property="id"/>
        <result column="kb_id"         property="kbId"/>
        <result column="storage_path"  property="storagePath"/>
        <result column="document_name" property="documentName"/>
        <result column="document_key"  property="documentKey"/>
    </resultMap>

    <!-- DISTINCT: a document links to one row per snapshot in scope; we want the document once. -->
    <select id="selectFileLocations" resultMap="docFileResult">
        SELECT DISTINCT
               d.id,
               d.kb_id,
               d.storage_path,
               d.document_name,
               d.document_key
        FROM asset_documents d
        JOIN asset_document_snapshot_links dsl ON d.id = dsl.document_id
        WHERE d.id IN
        <foreach collection="documentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND d.deleted_at IS NULL
        AND dsl.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
    </select>

</mapper>
