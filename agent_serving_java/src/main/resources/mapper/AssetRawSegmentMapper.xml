<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.AssetRawSegmentMapper">

    <resultMap id="segmentWithMetaResult"
               type="com.coremasterkb.serving.mapper.result.SegmentWithMetaRow">
        <result column="id"                   property="id"/>
        <result column="document_snapshot_id" property="documentSnapshotId"/>
        <result column="raw_text"             property="rawText"/>
        <result column="block_type"           property="blockType"/>
        <result column="semantic_role"        property="semanticRole"/>
        <result column="section_path"         property="sectionPath"/>
        <result column="entity_refs_json"     property="entityRefsJson"/>
        <result column="source_offsets_json"  property="sourceOffsetsJson"/>
        <result column="snapshot_title"       property="snapshotTitle"/>
        <result column="document_id"          property="documentId"/>
        <result column="document_key"         property="documentKey"/>
        <result column="relative_path"        property="relativePath"/>
        <result column="metadata_json"        property="metadataJson"/>
    </resultMap>

    <select id="selectWithMeta" resultMap="segmentWithMetaResult">
        SELECT rs.id,
               rs.document_snapshot_id,
               rs.raw_text,
               rs.block_type,
               rs.semantic_role,
               rs.section_path,
               rs.entity_refs_json,
               rs.source_offsets_json,
               rs.metadata_json,
               ds.title        AS snapshot_title,
               d.id            AS document_id,
               d.document_key,
               dsl.relative_path
        FROM asset_raw_segments rs
        LEFT JOIN asset_document_snapshots ds
               ON rs.document_snapshot_id = ds.id
        LEFT JOIN asset_document_snapshot_links dsl
               ON ds.id = dsl.document_snapshot_id
        LEFT JOIN asset_documents d
               ON dsl.document_id = d.id
        WHERE rs.id IN
        <foreach collection="segmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        <if test="snapshotIds != null and snapshotIds.size() > 0">
        AND rs.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        </if>
    </select>

    <resultMap id="segmentFullResult"
               type="com.coremasterkb.serving.mapper.result.SegmentFullRow">
        <result column="id"                   property="id"/>
        <result column="document_snapshot_id" property="documentSnapshotId"/>
        <result column="segment_key"          property="segmentKey"/>
        <result column="segment_index"        property="segmentIndex"/>
        <result column="raw_text"             property="rawText"/>
        <result column="block_type"           property="blockType"/>
        <result column="semantic_role"        property="semanticRole"/>
        <result column="section_path"         property="sectionPath"/>
        <result column="section_title"        property="sectionTitle"/>
        <result column="token_count"          property="tokenCount"/>
        <result column="snapshot_title"       property="snapshotTitle"/>
        <result column="metadata_json"        property="metadataJson"/>
    </resultMap>

    <!--
        No join to asset_document_snapshot_links: that link is 1:N and would duplicate rows.
        The snapshot filter is unconditional on purpose — see the Javadoc on selectFullByIds.
    -->
    <select id="selectFullByIds" resultMap="segmentFullResult">
        SELECT rs.id,
               rs.document_snapshot_id,
               rs.segment_key,
               rs.segment_index,
               rs.raw_text,
               rs.block_type,
               rs.semantic_role,
               rs.section_path,
               rs.section_title,
               rs.token_count,
               rs.metadata_json,
               ds.title AS snapshot_title
        FROM asset_raw_segments rs
        LEFT JOIN asset_document_snapshots ds
               ON rs.document_snapshot_id = ds.id
        WHERE rs.id IN
        <foreach collection="segmentIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND rs.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        ORDER BY rs.document_snapshot_id, rs.segment_index
    </select>

    <resultMap id="sectionPathCountMap"
               type="com.coremasterkb.serving.mapper.result.SectionPathCountRow">
        <result column="section_path" property="sectionPath"/>
        <result column="cnt"          property="cnt"/>
    </resultMap>

    <select id="selectSectionPathsByEntities" resultMap="sectionPathCountMap">
        SELECT rs.section_path AS section_path,
               COUNT(*)        AS cnt
        FROM asset_raw_segments rs
        WHERE rs.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
          AND rs.section_path &lt;&gt; '[]'
          AND rs.entity_refs_json != '[]'
          AND EXISTS (
              SELECT 1
              FROM jsonb_array_elements(rs.entity_refs_json::jsonb) AS e
              WHERE e->>'name' IN
              <foreach collection="entityNames" item="name" open="(" separator="," close=")">
                  #{name}
              </foreach>
          )
        GROUP BY rs.section_path
        ORDER BY cnt DESC
        LIMIT 200
    </select>

</mapper>
