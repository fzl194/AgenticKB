<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.AssetRetrievalUnitMapper">

    <resultMap id="ftsResultMap"
               type="com.coremasterkb.serving.mapper.result.FtsResultRow">
        <result column="id"                   property="id"/>
        <result column="document_snapshot_id" property="documentSnapshotId"/>
        <result column="text"                 property="text"/>
        <result column="title"                property="title"/>
        <result column="block_type"           property="blockType"/>
        <result column="semantic_role"        property="semanticRole"/>
        <result column="source_refs_json"     property="sourceRefsJson"/>
        <result column="facets_json"          property="facetsJson"/>
        <result column="target_type"          property="targetType"/>
        <result column="target_ref_json"      property="targetRefJson"/>
        <result column="unit_type"            property="unitType"/>
        <result column="source_segment_id"    property="sourceSegmentId"/>
        <result column="fts_score"            property="ftsScore"/>
    </resultMap>

    <resultMap id="detailsMap"
               type="com.coremasterkb.serving.mapper.result.FtsResultRow">
        <result column="id"                   property="id"/>
        <result column="text"                 property="text"/>
        <result column="source_refs_json"     property="sourceRefsJson"/>
        <result column="target_ref_json"      property="targetRefJson"/>
    </resultMap>

    <resultMap id="unitFullMap"
               type="com.coremasterkb.serving.mapper.result.FtsResultRow">
        <result column="id"                   property="id"/>
        <result column="document_snapshot_id" property="documentSnapshotId"/>
        <result column="text"                 property="text"/>
        <result column="title"                property="title"/>
        <result column="unit_type"            property="unitType"/>
        <result column="target_type"          property="targetType"/>
        <result column="source_refs_json"     property="sourceRefsJson"/>
        <result column="target_ref_json"      property="targetRefJson"/>
    </resultMap>

    <!-- Scope filter is unconditional here — see fetchDetailsByIdsInScope's Javadoc. -->
    <select id="fetchDetailsByIdsInScope" resultMap="unitFullMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               ru.text,
               ru.title,
               ru.unit_type,
               ru.target_type,
               ru.source_refs_json,
               ru.target_ref_json
        FROM asset_retrieval_units ru
        WHERE ru.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
    </select>

    <!--
        PostgreSQL full-text search using websearch_to_tsquery.
        ftsQuery format: "token1 OR token2 OR token3"
        Uses 'simple' dictionary — install pg_jieba for Chinese tokenization.
    -->
    <select id="searchByFts" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               ts_rank(
                   ru.search_vector,
                   websearch_to_tsquery('simple', #{ftsQuery})
               ) AS fts_score
        FROM asset_retrieval_units ru
        WHERE ru.search_vector @@ websearch_to_tsquery('simple', #{ftsQuery})
          AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        ORDER BY fts_score DESC
        LIMIT #{limit}
    </select>

    <!--
        tsvector search with scope filter (facets_json JSONB @> containment).
        scopeJsonParams is a list of JSON strings like {"product":["UDM"]}.
        Each is applied as a separate facets_json @> condition.
    -->
    <select id="searchByFtsWithScope" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               ts_rank(
                   ru.search_vector,
                   websearch_to_tsquery('simple', #{ftsQuery})
               ) AS fts_score
        FROM asset_retrieval_units ru
        WHERE ru.search_vector @@ websearch_to_tsquery('simple', #{ftsQuery})
          AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        <if test="scopeJsonParams != null and scopeJsonParams.size() > 0">
          AND
          <foreach collection="scopeJsonParams" item="jp" separator=" AND ">
              ru.facets_json @> #{jp}::jsonb
          </foreach>
        </if>
        <if test="sectionPrefixes != null and sectionPrefixes.size() > 0">
        AND EXISTS (
            SELECT 1 FROM asset_raw_segments rs
            WHERE rs.id = ru.source_segment_id
              AND lower(btrim(rs.section_path::jsonb -&gt; 0 -&gt;&gt; 'title')) IN
            <foreach collection="sectionPrefixes" item="p" open="(" separator="," close=")">
                #{p}
            </foreach>
        )
        </if>
        ORDER BY fts_score DESC
        LIMIT #{limit}
    </select>

    <!--
        pg_trgm trigram similarity fallback (no scope).
        Uses similarity() for scoring and % operator for threshold filter.
    -->
    <select id="searchByTrigram" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               similarity(ru.text, #{queryText}) AS fts_score
        FROM asset_retrieval_units ru
        WHERE ru.text % #{queryText}
          AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        ORDER BY fts_score DESC
        LIMIT #{limit}
    </select>

    <!--
        pg_trgm trigram similarity with scope filter.
    -->
    <select id="searchByTrigramWithScope" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               similarity(ru.text, #{queryText}) AS fts_score
        FROM asset_retrieval_units ru
        WHERE ru.text % #{queryText}
          AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        <if test="scopeJsonParams != null and scopeJsonParams.size() > 0">
          AND
          <foreach collection="scopeJsonParams" item="jp" separator=" AND ">
              ru.facets_json @> #{jp}::jsonb
          </foreach>
        </if>
        <if test="sectionPrefixes != null and sectionPrefixes.size() > 0">
        AND EXISTS (
            SELECT 1 FROM asset_raw_segments rs
            WHERE rs.id = ru.source_segment_id
              AND lower(btrim(rs.section_path::jsonb -&gt; 0 -&gt;&gt; 'title')) IN
            <foreach collection="sectionPrefixes" item="p" open="(" separator="," close=")">
                #{p}
            </foreach>
        )
        </if>
        ORDER BY fts_score DESC
        LIMIT #{limit}
    </select>

    <!--
        LIKE fallback (no scope): OR-connected LIKE clauses for each token.
    -->
    <select id="searchByLike" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               0.0 AS fts_score
        FROM asset_retrieval_units ru
        WHERE (
          <foreach collection="likeTerms" item="term" separator=" OR ">
              ru.text LIKE #{term}
          </foreach>
        )
          AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        LIMIT #{limit}
    </select>

    <!--
        LIKE fallback with scope filter.
    -->
    <select id="searchByLikeWithScope" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               0.0 AS fts_score
        FROM asset_retrieval_units ru
        WHERE (
          <foreach collection="likeTerms" item="term" separator=" OR ">
              ru.text LIKE #{term}
          </foreach>
        )
          AND ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
        <if test="scopeJsonParams != null and scopeJsonParams.size() > 0">
          AND
          <foreach collection="scopeJsonParams" item="jp" separator=" AND ">
              ru.facets_json @> #{jp}::jsonb
          </foreach>
        </if>
        <if test="sectionPrefixes != null and sectionPrefixes.size() > 0">
        AND EXISTS (
            SELECT 1 FROM asset_raw_segments rs
            WHERE rs.id = ru.source_segment_id
              AND lower(btrim(rs.section_path::jsonb -&gt; 0 -&gt;&gt; 'title')) IN
            <foreach collection="sectionPrefixes" item="p" open="(" separator="," close=")">
                #{p}
            </foreach>
        )
        </if>
        LIMIT #{limit}
    </select>

    <!--
        Entity-exact search using JSONB @> containment (GIN-indexable).
        entityContainmentParams: pre-built JSON strings like '[{"name":"SMF"}]'.
        Uses OR-connected @> checks, each of which can use the GIN index
        on entity_refs_json::jsonb. Falls back to entityNames IN-list when
        containment params are empty.
    -->
    <select id="searchByEntityExact" resultMap="ftsResultMap">
        SELECT ru.id,
               ru.document_snapshot_id,
               NULL::text AS text,
               ru.title,
               ru.block_type,
               ru.semantic_role,
               NULL::text AS source_refs_json,
               ru.facets_json,
               ru.target_type,
               NULL::text AS target_ref_json,
               ru.unit_type,
               ru.source_segment_id,
               0.95 AS fts_score
        FROM asset_retrieval_units ru
        WHERE ru.document_snapshot_id IN
        <foreach collection="snapshotIds" item="sid" open="(" separator="," close=")">
            #{sid}
        </foreach>
          AND ru.entity_refs_json::jsonb != '[]'::jsonb
          <if test="entityContainmentParams != null and entityContainmentParams.size() > 0">
          AND (
          <foreach collection="entityContainmentParams" item="jp" separator=" OR ">
              ru.entity_refs_json::jsonb @> #{jp}::jsonb
          </foreach>
          )
          </if>
          <if test="entityContainmentParams == null or entityContainmentParams.size() == 0">
          AND EXISTS (
              SELECT 1
              FROM jsonb_array_elements(ru.entity_refs_json::jsonb) AS e
              WHERE e->>'name' IN
              <foreach collection="entityNames" item="name" open="(" separator="," close=")">
                  #{name}
              </foreach>
          )
          </if>
          <if test="sectionPrefixes != null and sectionPrefixes.size() > 0">
          AND EXISTS (
              SELECT 1 FROM asset_raw_segments rs
              WHERE rs.id = ru.source_segment_id
                AND lower(btrim(rs.section_path::jsonb -&gt; 0 -&gt;&gt; 'title')) IN
              <foreach collection="sectionPrefixes" item="p" open="(" separator="," close=")">
                  #{p}
              </foreach>
          )
          </if>
        ORDER BY ru.weight DESC
        LIMIT #{limit}
    </select>

    <!--
        Hydration query: fetch heavy columns (text, source_refs_json, target_ref_json)
        only for the top-K survivors after fusion + rerank.
        Called once per search request with a small number of IDs (typically 10-30).
    -->
    <select id="fetchDetailsByIds" resultMap="detailsMap">
        SELECT ru.id,
               ru.text,
               ru.source_refs_json,
               ru.target_ref_json
        FROM asset_retrieval_units ru
        WHERE ru.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
