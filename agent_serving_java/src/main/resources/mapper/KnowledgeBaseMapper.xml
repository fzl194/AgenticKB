<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.KnowledgeBaseMapper">

    <!--
      The LEFT JOIN resolves X-KB-User to a kb_users row without requiring one to exist: when
      #{username} is null or unknown, u.id stays NULL, both the owner comparison and the member
      EXISTS evaluate false, and only 'public' KBs survive. That is the anonymous case — callers
      such as mcp_server send no identity header at all.
    -->
    <select id="selectAccessibleKbIds" resultType="java.lang.String">
        SELECT kb.id
        FROM knowledge_bases kb
        LEFT JOIN kb_users u
               ON u.username = #{username}
              AND u.status = 'active'
        WHERE kb.status = 'active'
          AND kb.domain = #{domain}
          AND kb.id IN
          <foreach collection="kbIds" item="kbId" open="(" separator="," close=")">
              #{kbId}
          </foreach>
          AND (
                kb.visibility = 'public'
                OR kb.owner_id = u.id
                OR EXISTS (
                    SELECT 1 FROM kb_members m
                    WHERE m.kb_id = kb.id AND m.user_id = u.id
                )
              )
    </select>

</mapper>
