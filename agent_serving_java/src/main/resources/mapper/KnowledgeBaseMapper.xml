<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.coremasterkb.serving.mapper.KnowledgeBaseMapper">

    <!--
      The LEFT JOIN resolves X-KB-User to a kb_users row without requiring one to exist: when
      #{username} is null or unknown, u.id stays NULL, the owner comparison, the member EXISTS
      and the user_domains EXISTS all evaluate false — the anonymous case is fully denied
      (51号批次1: public 域内化). mcp_server 调用实际携带 X-KB-User（client.py）；真正无身份头的匿名直连调用才会落到 NULL 分支。
    -->
    <select id="selectAccessibleKbIds" resultType="java.lang.String">
        SELECT kb.id
        FROM knowledge_bases kb
        LEFT JOIN kb_users u
               ON u.username = #{username}
              AND u.status = 'active'
        WHERE kb.status = 'active'
          AND kb.domain = #{domain}
          AND kb.id IN
          <foreach collection="kbIds" item="kbId" open="(" separator="," close=")">
              #{kbId}
          </foreach>
          AND (
                kb.owner_id = u.id
                OR EXISTS (
                    SELECT 1 FROM kb_members m
                    WHERE m.kb_id = kb.id AND m.user_id = u.id
                )
                  <!-- 1.0.2 修复：站点管理员全通（与 mining kb/db.list_visible_kb_ids 的
                       admin 分支对齐）——软删/跨域仍被上面的 status/domain 条件挡住。 -->
                OR u.site_role = 'admin'
                <!-- 51号批次1：public 域内化——须用户绑定该域（与 mining kb/db
                     list_visible_kb_ids 谓词逐字对齐；匿名 u.id 为 NULL 时自然拒绝） -->
                OR (kb.visibility = 'public'
                    AND EXISTS (
                        SELECT 1 FROM user_domains ud
                        WHERE ud.user_id = u.id AND ud.domain = kb.domain
                    ))
              )
    </select>

    <!-- 阶段 A：库级默认检索范式绑定（09_kb_default_paradigm.sql 加列）。DISTINCT 排除 NULL：
         恰好一行 = 绑定一致；多行 = 不一致（调用方降级）；零行 = 全部未绑定。 -->
    <select id="selectDefaultParadigmIds" resultType="java.lang.String">
        SELECT DISTINCT kb.default_paradigm_id
        FROM knowledge_bases kb
        WHERE kb.status = 'active'
          AND kb.domain = #{domain}
          AND kb.default_paradigm_id IS NOT NULL
          AND kb.id IN
          <foreach collection="kbIds" item="kbId" open="(" separator="," close=")">
              #{kbId}
          </foreach>
    </select>

</mapper>
